{
  "workspace": [
    "packages/jmap",
    "packages/jmap-mcp"
  ],
  "nodeModulesDir": "none",
  "tasks": {
    "start": "deno run --allow-env --allow-net packages/jmap-mcp/src/mod.ts",
    "watch": "deno run --allow-env --allow-net --watch packages/jmap-mcp/src/mod.ts",
    "check": "deno check packages/jmap/mod.ts packages/jmap-mcp/src/mod.ts",
    "fmt": "deno fmt",
    "lint": "deno lint packages",
    "test": "deno test --allow-env --allow-net",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "hooks:install": "deno run --allow-read=deno.json,.git/hooks/ --allow-write=.git/hooks/ jsr:@hongminhee/deno-task-hooks@0.1.2",
    "hooks:pre-commit": "deno task check && deno fmt --check && deno task lint",
    "hooks:pre-push": "deno task publish:check"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "exclude": [
      "**/CHANGELOG.md"
    ]
  },
  "exclude": [
    ".repositories"
  ]
}
